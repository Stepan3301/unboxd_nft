<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>UnboxdNFT</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <style>
        :root {
            --primary: #6c5ce7;
            --secondary: #00cec9;
            --accent: #fd79a8;
            --success: #00b894;
            --light-text: #dfe6e9;
            --tab-height: 60px;
            --gradient-gold: linear-gradient(to right, #f1c40f, #e67e22);
            --gradient-epic: linear-gradient(to right, #9b59b6, #8e44ad);
            --gradient-rare: linear-gradient(to right, #3498db, #2980b9);
            --gradient-common: linear-gradient(to right, #95a5a6, #7f8c8d);
            --dark: #2d3436;
            --light: #dfe6e9;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: white;
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 414px;
            margin: 0 auto;
            position: relative;
            height: 100vh;
            overflow: hidden;
            background: rgba(20, 20, 35, 0.9);
        }
        
        /* Header and Navigation */
        .header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            position: relative;
            z-index: 10;
        }
        
        .logo {
            font-weight: 800;
            font-size: 1.5rem;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
        }
        
        .logo i {
            margin-right: 8px;
            font-size: 1.2rem;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .user-info {
            display: flex;
            align-items: center;
        }
        
        .wallet {
            background: rgba(255, 255, 255, 0.1);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            margin-right: 10px;
        }
        
        .wallet img {
            width: 18px;
            height: 18px;
            margin-right: 5px;
        }
        
        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: linear-gradient(45deg, var(--primary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 0.9rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .nav {
            display: none; /* Hide by default */
            justify-content: space-around;
            padding: 15px 0;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(5px);
            position: relative;
            z-index: 10;
        }
        
        .nav.show {
            display: flex; /* Show when .show class is added */
        }
        
        .nav-item {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            font-weight: 500;
            padding: 5px 15px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .nav-item.active {
            color: white;
            background: rgba(108, 92, 231, 0.2);
            border: 1px solid rgba(108, 92, 231, 0.5);
        }
        
        /* Main Content */
        .main {
            padding: 20px;
            position: relative;
            z-index: 5;
        }
        
        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
            padding-bottom: 70px;
            overflow-y: auto;
            height: calc(100vh - 120px);
        }
        
        .tab-content.active {
            display: block;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Section Titles */
        .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            padding: 0;
        }
        
        .section-title i {
            margin-right: 8px;
            color: var(--accent);
        }
        
        /* Featured Case */
        .featured-case {
            margin-bottom: 30px;
            position: relative;
        }
        
        .featured-card {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(108, 92, 231, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .featured-image {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.4);
            position: relative;
        }
        
        .featured-image img {
            width: 70%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 0 20px rgba(108, 92, 231, 0.7));
            animation: float 3s ease-in-out infinite;
        }
        
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(5deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        
        .featured-info {
            padding: 20px;
            position: relative;
        }
        
        .featured-name {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 5px;
            background: linear-gradient(to right, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .featured-desc {
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 15px;
        }
        
        .featured-stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .stat {
            text-align: center;
            flex: 1;
        }
        
        .stat-value {
            font-weight: 700;
            font-size: 1rem;
            color: var(--secondary);
        }
        
        .stat-label {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.5);
        }
        
        .featured-action {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .featured-price {
            display: flex;
            align-items: center;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--secondary);
        }
        
        .featured-price img {
            width: 18px;
            height: 18px;
            margin-right: 5px;
        }
        
        .featured-btn {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }
        
        .featured-btn i {
            margin-left: 8px;
        }
        
        .featured-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.7);
        }
        
        /* Cases Grid */
        .cases-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 20px;
        }
        
        .case-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        
        .case-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(108, 92, 231, 0.3);
            border-color: rgba(108, 92, 231, 0.5);
        }
        
        .case-image {
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
        }
        
        .case-image img {
            width: 80%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 0 10px rgba(108, 92, 231, 0.5));
            transition: all 0.5s ease;
        }
        
        .case-card:hover .case-image img {
            transform: scale(1.1) rotate(-5deg);
        }
        
        .case-glow {
            position: absolute;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, rgba(108, 92, 231, 0.3) 0%, transparent 70%);
            opacity: 0;
            transition: all 0.5s ease;
        }
        
        .case-card:hover .case-glow {
            opacity: 1;
        }
        
        .case-info {
            padding: 15px;
        }
        
        .case-name {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        
        .case-rarity {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        
        .rarity-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 5px;
        }
        
        .legendary .rarity-indicator {
            background: linear-gradient(45deg, #f1c40f, #e67e22);
            box-shadow: 0 0 10px rgba(241, 196, 15, 0.7);
        }
        
        .epic .rarity-indicator {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
            box-shadow: 0 0 10px rgba(155, 89, 182, 0.7);
        }
        
        .rare .rarity-indicator {
            background: linear-gradient(45deg, #3498db, #2980b9);
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.7);
        }
        
        .common .rarity-indicator {
            background: linear-gradient(45deg, #95a5a6, #7f8c8d);
            box-shadow: 0 0 10px rgba(149, 165, 166, 0.7);
        }
        
        .rarity-text {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.7);
        }
        
        .case-price {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .price {
            display: flex;
            align-items: center;
            font-weight: 700;
            font-size: 1rem;
            color: var(--secondary);
        }
        
        .price i {
            margin-right: 5px;
            font-size: 0.9rem;
        }
        
        .open-btn {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }
        
        .open-btn i {
            margin-left: 5px;
        }
        
        .open-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(108, 92, 231, 0.5);
        }
        
        /* NFT Cards */
        .nft-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        
        .nft-image {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
        }
        
        .nft-info {
            padding: 15px;
        }
        
        .nft-title {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
        }
        
        .nft-price {
            display: flex;
            align-items: center;
            font-weight: 600;
            color: var(--secondary);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }
        
        .eth-icon {
            height: 16px;
            width: 16px;
            margin-right: 5px;
        }
        
        .btn {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 8px 0;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            text-align: center;
        }
        
        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(108, 92, 231, 0.5);
        }
        
        /* Rarity Badges */
        .rarity-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            padding: 5px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            z-index: 5;
        }
        
        .rarity-legendary {
            background: var(--gradient-gold);
        }
        
        .rarity-epic {
            background: var(--gradient-epic);
        }
        
        .rarity-rare {
            background: var(--gradient-rare);
        }
        
        .rarity-common {
            background: var(--gradient-common);
        }
        
        .rarity-mythic {
            background: linear-gradient(45deg, #f1c40f, #e74c3c);
            box-shadow: 0 0 15px rgba(241, 196, 15, 0.8);
        }
        
        .rarity-divine {
            background: linear-gradient(45deg, #ffffff, #6a11cb, #2575fc, #ffffff);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.9);
            animation: rainbow-glow 3s infinite;
        }
        
        @keyframes rainbow-glow {
            0% { box-shadow: 0 0 15px rgba(106, 17, 203, 0.8); }
            50% { box-shadow: 0 0 20px rgba(37, 117, 252, 0.9); }
            100% { box-shadow: 0 0 15px rgba(106, 17, 203, 0.8); }
        }
        
        /* Particles */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .particle {
            position: absolute;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: particleFloat linear infinite;
        }
        
        @keyframes particleFloat {
            0% { transform: translateY(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh); opacity: 0; }
        }
        
        /* Bottom Navigation */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 414px;
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 100;
        }
        
        .nav-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.7rem;
            transition: all 0.3s ease;
        }
        
        .nav-btn i {
            font-size: 1.2rem;
            margin-bottom: 5px;
        }
        
        .nav-btn.active {
            color: var(--primary);
        }
        
        .nav-btn.center {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: -25px;
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.5);
            position: relative;
            border: 3px solid rgba(0, 0, 0, 0.8);
        }
        
        .nav-btn.center i {
            margin: 0;
            font-size: 1.5rem;
            color: white;
        }
        
        .nav-btn.center span {
            position: absolute;
            bottom: -25px;
            color: white;
        }
        
        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--accent);
            color: white;
            font-size: 0.6rem;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        /* Profile Section */
        .profile-section {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
            text-align: center;
        }
        
        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent);
            margin: 0 auto 15px;
        }
        
        .profile-username {
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 5px;
        }
        
        .profile-bio {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 20px;
        }
        
        .profile-stats {
            display: flex;
            justify-content: space-around;
            margin-top: 20px;
        }
        
        .profile-stat {
            text-align: center;
        }
        
        /* Inventory Section */
        .inventory-item {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            margin-bottom: 10px;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .inventory-image {
            width: 60px;
            height: 60px;
            border-radius: 10px;
            margin-right: 15px;
            object-fit: cover;
        }
        
        .inventory-details {
            flex: 1;
        }
        
        .inventory-title {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        
        /* Info Section */
        .info-section {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
        }
        
        .info-section h2 {
            margin-bottom: 15px;
            font-size: 1.1rem;
            font-weight: 700;
        }
        
        .info-section h3 {
            font-size: 1rem;
            margin: 15px 0 10px;
            color: var(--primary);
        }
        
        .info-section p {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.5;
        }
        
        .info-section ul {
            margin-left: 20px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
        }
        
        .info-section li {
            margin-bottom: 8px;
        }
        
        .rarity-text {
            font-weight: 600;
        }
        
        /* Labubu Skins List */
        .skins-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
        }
        
        .skin-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        
        .skin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(108, 92, 231, 0.3);
            border-color: rgba(108, 92, 231, 0.5);
        }
        
        .skin-image {
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.2);
            padding: 10px;
        }
        
        .skin-image img {
            max-height: 100%;
            width: auto;
            object-fit: contain;
        }
        
        .skin-info {
            padding: 10px;
            text-align: center;
        }
        
        .skin-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
        }
        
        /* Roulette Styles */
        .roulette-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        
        .roulette-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }
        
        .roulette-container {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
            position: relative;
            margin-bottom: 20px;
            padding: 0 20px;
        }
        
        .roulette-header {
            text-align: center;
            margin-bottom: 20px;
            color: white;
        }
        
        .roulette-header h2 {
            font-size: 1.5rem;
            margin-bottom: 5px;
            background: linear-gradient(to right, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .roulette-track {
            display: flex;
            transition: transform 7s cubic-bezier(0.17, 0.67, 0.83, 0.67);
        }
        
        .roulette-item {
            flex: 0 0 120px;
            height: 150px;
            background: rgba(20, 20, 35, 0.8);
            margin: 0 5px;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 10px;
            border: 2px solid rgba(108, 92, 231, 0.3);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }
        
        .roulette-item img {
            max-width: 90%;
            max-height: 90px;
            object-fit: contain;
        }
        
        .roulette-item-name {
            font-size: 0.7rem;
            margin-top: 5px;
            color: white;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }
        
        .roulette-marker {
            position: absolute;
            left: 50%;
            top: 0;
            height: 100%;
            width: 4px;
            background: linear-gradient(to bottom, var(--primary), var(--accent));
            transform: translateX(-50%);
            z-index: 10;
            box-shadow: 0 0 15px rgba(108, 92, 231, 0.8);
        }
        
        .roulette-result {
            margin-top: 20px;
            text-align: center;
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.5s ease;
        }
        
        .roulette-result.active {
            opacity: 1;
            transform: scale(1);
        }
        
        .roulette-result-image {
            width: 150px;
            height: 150px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            border: 2px solid rgba(108, 92, 231, 0.5);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.5);
        }
        
        .roulette-result-image img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }
        
        .roulette-result-name {
            font-size: 1.2rem;
            font-weight: bold;
            color: white;
            margin-bottom: 5px;
        }
        
        .roulette-close {
            margin-top: 20px;
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .roulette-close:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.7);
        }
        
        .roulette-buttons {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }
        
        .roulette-sell {
            background: linear-gradient(45deg, #00b894, #00cec9);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }
        
        .roulette-sell i {
            margin-right: 8px;
        }
        
        .roulette-sell:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(0, 184, 148, 0.7);
        }
        
        .skin-price {
            font-size: 0.8rem;
            color: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 5px;
        }
        
        .skin-price img {
            width: 14px;
            height: 14px;
            margin-right: 4px;
        }
        
        /* Case Detail View */
        .case-detail {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
            padding: 0;
            margin: 0;
            overflow-y: auto;
            height: 100vh;
            background: rgba(20, 20, 35, 0.9);
        }
        
        .case-detail.active {
            display: block;
        }
        
        .case-detail-header {
            display: flex;
            align-items: center;
            margin: 0;
            padding: 15px;
            background-color: rgba(0, 0, 0, 0.3);
        }
        
        .case-detail-back {
            background: rgba(0, 0, 0, 0.3);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .case-detail-back:hover {
            background: rgba(108, 92, 231, 0.3);
            transform: scale(1.1);
        }
        
        .case-detail-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: white;
        }
        
        .case-detail .featured-card {
            margin-top: 0;
            border-radius: 0;
        }
        
        /* Custom Dialog Styles */
        .custom-dialog {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .custom-dialog.active {
            opacity: 1;
            pointer-events: auto;
        }

        .dialog-content {
            background: rgba(20, 20, 35, 0.95);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            max-width: 320px;
            width: 90%;
            box-shadow: 0 0 30px rgba(108, 92, 231, 0.5);
            border: 2px solid rgba(108, 92, 231, 0.3);
            transform: scale(0.9);
            transition: transform 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .custom-dialog.active .dialog-content {
            transform: scale(1);
        }

        .dialog-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            background: linear-gradient(to right, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .dialog-message {
            font-size: 1rem;
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.9);
        }

        .dialog-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: var(--accent);
            animation: pulse 2s infinite;
        }

        .dialog-btn {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .dialog-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.7);
        }

        .dialog-confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            opacity: 0;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        @keyframes confettiFall {
            to {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }

        /* Not Enough Balance Dialog */
        .not-enough-balance-dialog {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .not-enough-balance-dialog.active {
            opacity: 1;
            pointer-events: auto;
        }

        .not-enough-balance-content {
            background: rgba(20, 20, 35, 0.95);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            max-width: 320px;
            width: 90%;
            box-shadow: 0 0 30px rgba(255, 0, 0, 0.3);
            border: 2px solid rgba(255, 0, 0, 0.3);
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }

        .not-enough-balance-dialog.active .not-enough-balance-content {
            transform: scale(1);
        }

        .not-enough-balance-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #ff4757;
        }

        .not-enough-balance-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: #ff4757;
        }

        .not-enough-balance-message {
            font-size: 1rem;
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.9);
        }

        .not-enough-balance-btn {
            background: linear-gradient(45deg, #ff4757, #ff6b81);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .not-enough-balance-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 71, 87, 0.4);
        }

        /* Add tier-based text colors */
        .tier-1 {
            color: #95a5a6; /* Grey */
        }

        .tier-2 {
            color: #3498db; /* Blue */
        }

        .tier-3 {
            color: #9b59b6; /* Purple */
        }

        .tier-4 {
            color: #e74c3c; /* Red */
        }

        .tier-5 {
            color: #f1c40f; /* Golden */
        }

        .tier-6 {
            background: linear-gradient(to right, #f5f7fa, #c3cfe2, #6a11cb, #2575fc, #ffffff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: rainbow 3s ease-in-out infinite;
        }

        @keyframes rainbow {
            0% { filter: hue-rotate(0deg); }
            50% { filter: hue-rotate(45deg); }
            100% { filter: hue-rotate(0deg); }
        }

        /* Update to match the style with Awesome button */
        .roulette-sell {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .roulette-sell i {
            margin-right: 8px;
        }

        .roulette-sell:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.7);
        }

        /* Add style for inventory sell button */
        .inventory-sell-btn {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 8px 0;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            text-align: center;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .inventory-sell-btn i {
            margin-right: 5px;
        }

        .inventory-sell-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(108, 92, 231, 0.5);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="particles" id="particles"></div>
        
        <header class="header">
            <div class="logo">
                <i class="fas fa-cube"></i> UnboxdNFT
            </div>
            <div class="user-info">
                <div class="wallet">
                    <img src="ucoin2.png" alt="UCoin" />
                    <span id="user-balance">0</span>
                </div>
                <div class="avatar" id="user-avatar">
                    <!-- No image by default, will be set when user data is loaded -->
                </div>
            </div>
        </header>
        
        <nav class="nav" id="rarity-nav">
            <div class="nav-item active" data-tab="all">All Cases</div>
            <div class="nav-item" data-tab="legendary">Legendary</div>
            <div class="nav-item" data-tab="epic">Epic</div>
            <div class="nav-item" data-tab="rare">Rare</div>
        </nav>
        
        <main class="main">
            <!-- Cases Tab -->
            <div class="tab-content active" id="cases-tab">
                <div class="featured-case">
                    <h2 class="section-title">
                        <i class="fas fa-star"></i> Featured Case
                    </h2>
                    <div class="featured-card">
                        <div class="featured-image">
                            <img src="LabubuCase.png" alt="Labubu Case">
                        </div>
                        <div class="featured-info">
                            <h3 class="featured-name">Labubu Collection</h3>
                            <p class="featured-desc">Exclusive collection of rare Labubu skins from the popular artist series. Collect all 9 unique skins!</p>
                            
                            <div class="featured-stats">
                                <div class="stat">
                                    <div class="stat-value">9</div>
                                    <div class="stat-label">SKINS</div>
                                </div>
                                <div class="stat">
                                    <div class="stat-value">3</div>
                                    <div class="stat-label">RARE</div>
                                </div>
                                <div class="stat">
                                    <div class="stat-value">2</div>
                                    <div class="stat-label">EPIC</div>
                                </div>
                            </div>
                            
                            <div class="featured-action">
                                <div class="featured-price">
                                    <img src="ucoin2.png" alt="UCoin" /> 100
                                </div>
                                <button class="featured-btn" data-case="labubu">
                                    View Case <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <h2 class="section-title">
                    <i class="fas fa-boxes"></i> Popular Cases
                </h2>
                
                <!-- No dummy cases here, only showing the featured Labubu case -->
                <div class="cases-grid">
                    <div class="case-card">
                        <div class="case-image">
                            <div class="case-glow"></div>
                            <img src="LabubuCase.png" alt="Labubu Case">
                        </div>
                        <div class="case-info">
                            <h3 class="case-name">Labubu Collection</h3>
                            <div class="case-rarity rare">
                                <div class="rarity-indicator"></div>
                                <div class="rarity-text">RARE</div>
                            </div>
                            <div class="case-price">
                                <div class="price">
                                    <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;"/> 100
                                </div>
                                <button class="open-btn" data-case="labubu">
                                    View <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Marketplace Tab -->
            <div class="tab-content" id="marketplace-tab">
                <h2 class="section-title">
                    <i class="fas fa-store"></i> Marketplace
                </h2>
                
                <div class="cases-grid">
                    <div class="nft-card">
                        <span class="rarity-badge rarity-legendary">Legendary</span>
                        <img src="AlienLabubu.png" alt="Alien Labubu" class="nft-image">
                        <div class="nft-info">
                            <div class="nft-title">Alien Labubu</div>
                            <div class="nft-price">
                                <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;"/> 250
                            </div>
                            <button class="btn">Buy Now</button>
                        </div>
                    </div>
                    
                    <div class="nft-card">
                        <span class="rarity-badge rarity-epic">Epic</span>
                        <img src="SkeletonLabubu.png" alt="Skeleton Labubu" class="nft-image">
                        <div class="nft-info">
                            <div class="nft-title">Skeleton Labubu</div>
                            <div class="nft-price">
                                <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;"/> 180
                            </div>
                            <button class="btn">Buy Now</button>
                        </div>
                    </div>
                    
                    <div class="nft-card">
                        <span class="rarity-badge rarity-rare">Rare</span>
                        <img src="ZombieLabubu.png" alt="Zombie Labubu" class="nft-image">
                        <div class="nft-info">
                            <div class="nft-title">Zombie Labubu</div>
                            <div class="nft-price">
                                <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;"/> 95
                            </div>
                            <button class="btn">Buy Now</button>
                        </div>
                    </div>
                    
                    <div class="nft-card">
                        <span class="rarity-badge rarity-uncommon">Uncommon</span>
                        <img src="GrassLabubu.png" alt="Grass Labubu" class="nft-image">
                        <div class="nft-info">
                            <div class="nft-title">Grass Labubu</div>
                            <div class="nft-price">
                                <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;"/> 35
                            </div>
                            <button class="btn">Buy Now</button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Inventory Tab -->
            <div class="tab-content" id="inventory-tab">
                <h2 class="section-title">
                    <i class="fas fa-box-open"></i> Your Collection
                </h2>
                
                <div id="user-collection" class="cases-grid">
                    <!-- This will be populated dynamically when user opens cases -->
                    <div class="empty-collection-message" style="width: 100%; text-align: center; padding: 30px; color: rgba(255,255,255,0.7);">
                        <i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 15px; opacity: 0.5;"></i>
                        <p>Your collection is empty. Open some cases to get Labubu skins!</p>
                    </div>
                </div>
            </div>
            
            <!-- Profile Tab -->
            <div class="tab-content" id="profile-tab">
                <h2 class="section-title">
                    <i class="fas fa-user"></i> Profile
                </h2>
                
                <div class="profile-section">
                    <img alt="Profile" class="profile-avatar" id="profile-avatar">
                    <h2 class="profile-username" id="profile-username">CryptoCollector</h2>
                    <p class="profile-bio" id="profile-bio">NFT enthusiast and collector since 2021</p>
                    
                    <div class="featured-stats">
                        <div class="stat">
                            <div class="stat-value" id="profile-nfts-count">0</div>
                            <div class="stat-label">NFTs</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value" id="profile-cases-opened">0</div>
                            <div class="stat-label">CASES OPENED</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value" id="profile-legendary-count">0</div>
                            <div class="stat-label">LEGENDARY</div>
                        </div>
                    </div>
                    
                    <div class="wallet" style="width: fit-content; margin: 20px auto 0;">
                        <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin-right: 5px;">
                        <span id="profile-balance">0</span>
                    </div>
                </div>
                
                <h2 class="section-title" style="margin-top: 20px;">
                    <i class="fas fa-crown"></i> Achievements
                </h2>
                
                <div class="cases-grid">        }
        
        .roulette-sell i {
            margin-right: 8px;
        }
        
        .roulette-sell:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108, 92, 231, 0.7);

        /* Add style for inventory sell button */
        .inventory-sell-btn {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 8px 0;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            text-align: center;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .inventory-sell-btn i {
            margin-right: 5px;
        }

        .inventory-sell-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(108, 92, 231, 0.5);
        }        }                    <div class="inventory-item" style="width: 100%;">
                        <i class="fas fa-trophy" style="color: gold; font-size: 24px; margin-right: 15px;"></i>
                        <div class="inventory-details">
                            <div class="inventory-title">First Legendary</div>
                            <div style="font-size: 0.8rem; color: rgba(255,255,255,0.7);">Obtained your first legendary NFT</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Info Tab -->
            <div class="tab-content" id="info-tab">
                <h2 class="section-title">
                    <i class="fas fa-info-circle"></i> About
                </h2>
                
                <div class="info-section">
                    <h2>About UnboxdNFT</h2>
                    <p>UnboxdNFT is a platform that allows users to open digital cases containing NFTs of varying rarity. The platform uses blockchain technology to ensure transparency and authenticity of all transactions and NFT ownership.</p>
                    
                    <h3>How it Works</h3>
                    <p>1. Purchase a case using ETH or UCoins<br>
                    2. Open the case to reveal your NFT<br>
                    3. Keep your NFT in your collection or sell it on the marketplace</p>
                    
                    <h3>Rarity Levels</h3>
                    <ul>
                        <li><span class="rarity-text" style="color: #f1c40f;">Legendary</span> - Extremely rare and valuable NFTs (1% chance)</li>
                        <li><span class="rarity-text" style="color: #9b59b6;">Epic</span> - Very rare NFTs with special attributes (5% chance)</li>
                        <li><span class="rarity-text" style="color: #3498db;">Rare</span> - Uncommon NFTs with unique features (15% chance)</li>
                        <li><span class="rarity-text" style="color: #95a5a6;">Common</span> - Standard NFTs that are more widely available (79% chance)</li>
                    </ul>
                    
                    <h3>Contact Support</h3>
                    <p>Need help or have questions? Contact our support team through the Telegram bot. We're available 24/7 to assist with any issues or inquiries about the platform.</p>
                </div>
            </div>
        </main>
        
        <nav class="bottom-nav">
            <div class="nav-btn active" data-tab="cases-tab">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </div>
            <div class="nav-btn" data-tab="marketplace-tab">
                <i class="fas fa-search"></i>
                <span>Explore</span>
            </div>
            <div class="nav-btn center">
                <i class="fas fa-box-open"></i>
                <span>Cases</span>
            </div>
            <div class="nav-btn" data-tab="inventory-tab">
                <i class="fas fa-trophy"></i>
                <span>Inventory</span>
            </div>
            <div class="nav-btn" data-tab="profile-tab">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </div>
        </nav>
    </div>

    <!-- Labubu Case Detail -->
    <div class="case-detail" id="labubu-case-detail">
        <div class="case-detail-header">
            <div class="case-detail-back" id="labubu-case-back">
                <i class="fas fa-arrow-left"></i>
            </div>
            <div class="case-detail-title">Labubu Collection</div>
        </div>
        
        <div class="featured-card">
            <div class="featured-image">
                <img src="LabubuCase.png" alt="Labubu Case">
            </div>
            <div class="featured-info">
                <p class="featured-desc">Unleash your Labubu collection with this exclusive case featuring 9 unique Labubu skins. Which one will you get?</p>
                
                <div class="featured-action" style="justify-content: center; margin-top: 20px;">
                    <button class="featured-btn open-case-btn" data-case="labubu">
                        Open Case for <img src="ucoin2.png" alt="UCoin" style="width: 18px; height: 18px; margin: 0 5px;"> 100
                    </button>
                </div>
            </div>
        </div>
        
        <h2 class="section-title" style="margin-top: 30px; padding-left: 20px;">
            <i class="fas fa-list"></i> Possible Drops
        </h2>
        
        <div class="skins-grid" style="padding: 0 20px 20px;">
            <div class="skin-card">
                <div class="skin-image">
                    <img src="VolcanicLabubu.png" alt="Volcanic Labubu">
                </div>
                <div class="skin-info">
                    <div class="skin-name tier-6">Volcanic Labubu</div>

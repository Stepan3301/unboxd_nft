    <!-- Roulette Overlay -->
    <div class="roulette-overlay" id="roulette-overlay">
        <div class="roulette-header">
            <h2>Opening Labubu Case</h2>
            <p>Good luck!</p>
        </div>
        
        <div class="roulette-container">
            <div class="roulette-marker"></div>
            <div class="roulette-track" id="roulette-track"></div>
        </div>
        
        <div class="roulette-result" id="roulette-result">
            <h3>Congratulations!</h3>
            <div class="roulette-result-image">
                <img id="result-image" src="" alt="Your new skin">
            </div>
            <div class="roulette-result-name" id="result-name"></div>
            <div class="roulette-buttons">
                <button class="roulette-close" id="roulette-close">Awesome!</button>
                <button class="roulette-sell" id="roulette-sell">
                    <i class="fas fa-coins"></i> Sell for <span id="sell-price">0</span>
                </button>
